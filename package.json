{
  "name": "like-cidade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "npm start",
    "test": "node --import tsx --test src/domain.test.ts server/*.test.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "backup": "node --env-file-if-exists=.env dist-server/server/backup.js",
    "seed:demo": "node --env-file-if-exists=.env dist-server/server/seed-demo.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.58.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
