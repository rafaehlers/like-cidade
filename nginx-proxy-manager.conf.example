# Advanced / Settings configuration for the likecidade.com.br proxy host.
# Forward destination: http://like-cidade-app:3000 on proxy-network.
client_max_body_size 5m;
proxy_buffering off;
proxy_cache off;
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;

# This exact match takes precedence over any server-wide /api/events location.
location = /api/events {
  proxy_pass http://like-cidade-app:3000;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 3600s;
  gzip off;
}
