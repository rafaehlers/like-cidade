VITE_GOOGLE_MAPS_API_KEY=
# true agrupa os pins próximos; false mantém todos os pins individuais.
VITE_MAP_CLUSTERING_ENABLED=true

# Servidor compartilhado (estas variáveis não são enviadas ao navegador).
HOST=127.0.0.1
PORT=3001
SQLITE_PATH=./data/like-cidade.sqlite

# Origem pública usada nas prévias de links compartilhados.
PUBLIC_SITE_URL=https://likecidade.com.br
